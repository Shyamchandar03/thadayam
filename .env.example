# Copy this file to .env and fill in your values. Never commit .env (it is in .gitignore).

GEMINI_API_KEY=

# Best voice: https://elevenlabs.io -> Profile -> API keys. Empty = free Edge TTS voice.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=nPczCjzI2devNBz1zQrb
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Stock video on spoken words (free): https://www.pexels.com/api  /  https://pixabay.com/api/docs
PEXELS_API_KEY=
PIXABAY_API_KEY=

YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

IG_USER_ID=
IG_ACCESS_TOKEN=
INSTAGRAM_AUTOPUBLISH=true

SERIES_NAME_EN=Marma Mudichu
# tanglish = captions in English letters (works on any PC). tamil = Tamil script captions.
ON_SCREEN_TEXT=tanglish

# Optional
# POLLINATIONS_API_KEY=
# YOUTUBE_PRIVACY=private
# TTS_VOICE=ta-IN-ValluvarNeural
# SHOUTOUTS=Rahul,Priya
